<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="NativeScreenDimmer_WinUI3.RuleEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:NativeScreenDimmer_WinUI3"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Rule editor"
    PrimaryButtonText="Done"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind IsRuleValid, Mode=OneWay}"
    Width="620"
    MaxWidth="720">

    <Grid Padding="4">
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="640">
            <StackPanel Spacing="12">
                <TextBlock Text="Tell it what to watch, where to apply, and how strong it should be." TextWrapping="Wrap" />

                <Border Padding="12"
                        CornerRadius="12"
                        Background="{ThemeResource NoirLumenSurfaceAltBrush}"
                        BorderBrush="{ThemeResource NoirLumenStrokeBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Basics" FontWeight="SemiBold" />
                        <TextBox Header="Rule name"
                                 PlaceholderText="Short label shown in the list"
                                 Text="{Binding Name, Mode=TwoWay}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ToggleSwitch Header="Enabled" IsOn="{Binding IsEnabled, Mode=TwoWay}" />
                            <ComboBox Grid.Column="1"
                                      Header="Rule type"
                                      ItemsSource="{x:Bind RuleTypes}"
                                      SelectedItem="{Binding Type, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="Priority"
                                     PlaceholderText="Higher wins when rules overlap"
                                     Text="{Binding Priority, Mode=TwoWay}" />
                            <TextBox Grid.Column="1"
                                     Width="120"
                                     Header="Dim %"
                                     PlaceholderText="0-95"
                                     Text="{Binding DimPercent, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Padding="12"
                        CornerRadius="12"
                        Background="{ThemeResource NoirLumenSurfaceAltBrush}"
                        BorderBrush="{ThemeResource NoirLumenStrokeBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Where it applies" FontWeight="SemiBold" />
                        <ComboBox Header="Screen scope"
                                  ItemsSource="{x:Bind RuleTargetScopes}"
                                  SelectedItem="{Binding TargetScope, Mode=TwoWay}" />
                        <StackPanel Spacing="6"
                                    Visibility="{x:Bind SpecificScreenVisibility, Mode=OneWay}">
                            <TextBlock Text="Pick screens" />
                            <ItemsControl ItemsSource="{x:Bind DisplayTargets, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:DisplayTargetOption">
                                        <CheckBox Content="{x:Bind DisplayName}"
                                                  IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Padding="12"
                        CornerRadius="12"
                        Background="{ThemeResource NoirLumenSurfaceAltBrush}"
                        BorderBrush="{ThemeResource NoirLumenStrokeBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="What to watch" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ConditionHintText, Mode=OneWay}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                        <Grid ColumnSpacing="8"
                              Visibility="{x:Bind TimeRuleVisibility, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="Start time"
                                     PlaceholderText="HH:mm, like 21:00"
                                     Text="{Binding StartTime, Mode=TwoWay}" />
                            <TextBox Grid.Column="1"
                                     Header="End time"
                                     PlaceholderText="HH:mm, like 06:00"
                                     Text="{Binding EndTime, Mode=TwoWay}" />
                        </Grid>
                        <TextBox Header="Process name"
                                 PlaceholderText="exe name, like game.exe"
                                 Visibility="{x:Bind ProcessRuleVisibility, Mode=OneWay}"
                                 Text="{Binding ProcessName, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <Border Padding="12"
                        CornerRadius="12"
                        Background="{ThemeResource NoirLumenSurfaceAltBrush}"
                        BorderBrush="{ThemeResource NoirLumenStrokeBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Color" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="Hex color"
                                     PlaceholderText="#000000"
                                     Text="{Binding ColorHex, Mode=TwoWay}" />
                            <Button Grid.Column="1"
                                    VerticalAlignment="Bottom"
                                    Content="Pick color"
                                    Click="PickColor_OnClick"
                                    Style="{StaticResource NoirLumenSecondaryButtonStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Padding="12"
                        CornerRadius="12"
                        Background="{ThemeResource NoirLumenSurfaceAltBrush}"
                        BorderBrush="{ThemeResource NoirLumenStrokeBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Preview" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind PreviewText, Mode=OneWay}" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{x:Bind ValidationIssues, Mode=OneWay}"
                                      Visibility="{x:Bind ValidationIssuesVisibility, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentDialog>
