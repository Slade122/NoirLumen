<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Name="RootPage"
    x:Class="NativeScreenDimmer_WinUI3.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:NativeScreenDimmer_WinUI3.Models"
    mc:Ignorable="d">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="12" CornerRadius="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="NoirLumen" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="Modern WinUI shell with per-monitor dimming and automation." Opacity="0.75" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Theme" VerticalAlignment="Center" />
                    <ComboBox Width="110"
                              ItemsSource="{Binding ThemeModes}"
                              SelectedItem="{Binding AppThemeSelection, Mode=TwoWay}" />
                    <ToggleSwitch Header="Automation"
                                  IsOn="{Binding AutomationEnabled, Mode=TwoWay}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="12" CornerRadius="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Displays" FontSize="18" FontWeight="SemiBold" />
                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding MonitorSettings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10" Margin="0,0,0,10" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <CheckBox Content="Enable overlay" IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                                            <CheckBox Content="Include in sun mimic" IsChecked="{Binding SunMimicEnabled, Mode=TwoWay}" />
                                            <TextBlock Text="Dim level" />
                                            <Slider Minimum="0" Maximum="95" Value="{Binding DimPercent, Mode=TwoWay}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="Blue light" VerticalAlignment="Center" />
                                                <ComboBox Width="120" SelectedIndex="{Binding BlueLightMode, Mode=TwoWay}">
                                                    <ComboBoxItem Content="Off" />
                                                    <ComboBoxItem Content="Gentle" />
                                                    <ComboBoxItem Content="Warm" />
                                                    <ComboBoxItem Content="Amber" />
                                                    <ComboBoxItem Content="Red" />
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBox Width="125" Text="{Binding ColorHex, Mode=TwoWay}" />
                                                <Button Content="Pick" Tag="{Binding}" Click="PickMonitorColor_OnClick" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Padding="12" CornerRadius="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <ToggleSwitch Header="Mimic the sun schedule" IsOn="{Binding SunMimicEnabled, Mode=TwoWay}" />
                            <TextBlock Text="Sun-power decay ramps up dimming through late day into night." Opacity="0.75" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                <TextBlock Text="Lat" VerticalAlignment="Center" />
                                <TextBox Width="80" Text="{Binding Latitude, Mode=TwoWay}" />
                                <TextBlock Text="Lon" VerticalAlignment="Center" />
                                <TextBox Width="85" Text="{Binding Longitude, Mode=TwoWay}" />
                                <TextBlock Text="Max" VerticalAlignment="Center" />
                                <TextBox Width="52" Text="{Binding SunMimicMaximumDimPercent, Mode=TwoWay}" />
                                <Button Content="Auto detect" Click="AutoDetectLocation_OnClick" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding SunMimicStatusText}" FontWeight="SemiBold" />
                    </Grid>
                </Border>

                <Border Grid.Row="1" Padding="12" CornerRadius="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Automation rules" FontSize="18" FontWeight="SemiBold" />
                        <ListView Grid.Row="1"
                                  ItemsSource="{Binding Rules}"
                                  SelectedItem="{Binding SelectedRule, Mode=TwoWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8" Margin="0,0,0,8" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <StackPanel Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" Content="On" />
                                                <TextBox Width="130" Text="{Binding Name, Mode=TwoWay}" />
                                                <ComboBox Width="130" SelectedIndex="{Binding Type, Mode=TwoWay}">
                                                    <ComboBoxItem Content="TimeRange" />
                                                    <ComboBoxItem Content="ProcessRunning" />
                                                </ComboBox>
                                                <ComboBox Width="130" SelectedIndex="{Binding TargetScope, Mode=TwoWay}">
                                                    <ComboBoxItem Content="AllScreens" />
                                                    <ComboBoxItem Content="SpecificScreen" />
                                                </ComboBox>
                                                <TextBox Width="140" PlaceholderText="Target Device" Text="{Binding TargetDeviceName, Mode=TwoWay}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBox Width="72" PlaceholderText="Start" Text="{Binding StartTime, Mode=TwoWay}" />
                                                <TextBox Width="72" PlaceholderText="End" Text="{Binding EndTime, Mode=TwoWay}" />
                                                <TextBox Width="96" PlaceholderText="Process" Text="{Binding ProcessName, Mode=TwoWay}" />
                                                <TextBox Width="60" PlaceholderText="Dim%" Text="{Binding DimPercent, Mode=TwoWay}" />
                                                <TextBox Width="86" Text="{Binding ColorHex, Mode=TwoWay}" />
                                                <TextBox Width="70" PlaceholderText="Priority" Text="{Binding Priority, Mode=TwoWay}" />
                                                <Button Content="Pick" Tag="{Binding}" Click="PickRuleColor_OnClick" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Content="Add Time Rule" Click="AddTimeRule_OnClick" />
                            <Button Content="Add Process Rule" Click="AddProcessRule_OnClick" />
                            <Button Content="Remove Selected" Click="RemoveRule_OnClick" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Padding="12" CornerRadius="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Tip: process rules use exe name (example: game.exe). Time format: HH:mm." VerticalAlignment="Center" Opacity="0.75" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Apply Now" Click="ApplyNow_OnClick" />
                    <Button Content="Save" Click="Save_OnClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
