<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Name="RootPage"
    x:Class="NativeScreenDimmer_WinUI3.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource NoirLumenPageBackgroundBrush}">

    <Page.Resources>
        <Style x:Key="NoirSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="NoirSectionBodyStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="NoirSurfaceButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="MinWidth" Value="100" />
        </Style>

        <Style x:Key="NoirMetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="NoirMetricLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid Padding="12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="12"
                CornerRadius="12"
                Background="{ThemeResource NoirLumenSurfaceBrush}"
                BorderBrush="{ThemeResource NoirLumenStrokeBrush}"
                BorderThickness="1">
            <Grid ColumnSpacing="12" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Width="9" Height="9" CornerRadius="4.5" Background="{ThemeResource NoirLumenAccentBrush}" />
                        <TextBlock Text="NOIRLUMEN"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="120"
                                   Foreground="{ThemeResource NoirLumenAccentBrush}" />
                    </StackPanel>
                    <TextBlock Text="A denser, quieter control center for per-monitor dimming."
                               FontSize="22"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Native overlays, automation, and sun mimic — less padding, less noise, more control."
                               Style="{StaticResource NoirSectionBodyStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <TextBlock Text="Theme" VerticalAlignment="Center" />
                        <ComboBox Width="110"
                                  ItemsSource="{Binding ThemeModes}"
                                  SelectedItem="{Binding AppThemeSelection, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <ToggleSwitch Header="Automation" IsOn="{Binding AutomationEnabled, Mode=TwoWay}" />
                        <ToggleSwitch Header="Sun mimic" IsOn="{Binding SunMimicEnabled, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Balanced" Click="BalancedPreset_OnClick" Style="{StaticResource NoirSurfaceButtonStyle}" />
                        <Button Content="Evening" Click="EveningPreset_OnClick" Style="{StaticResource NoirSurfaceButtonStyle}" />
                        <Button Content="Performance" Click="PerformancePreset_OnClick" Style="{StaticResource NoirSurfaceButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid ColumnSpacing="10" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1.1*" />
                </Grid.ColumnDefinitions>

                <Border Padding="12"
                        CornerRadius="12"
                        Background="{ThemeResource NoirLumenSurfaceBrush}"
                        BorderBrush="{ThemeResource NoirLumenStrokeBrush}"
                        BorderThickness="1">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="3">
                            <TextBlock Text="Displays" Style="{StaticResource NoirSectionTitleStyle}" />
                            <TextBlock Text="Compact per-monitor controls, tint, and sun inclusion." Style="{StaticResource NoirSectionBodyStyle}" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding MonitorSettings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8"
                                                Padding="10"
                                                CornerRadius="10"
                                                Background="{ThemeResource NoirLumenSurfaceAltBrush}"
                                                BorderBrush="{ThemeResource NoirLumenStrokeBrush}"
                                                BorderThickness="1">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.1*" />
                                                    <ColumnDefinition Width="1.4*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding DeviceName}" Style="{StaticResource NoirSectionBodyStyle}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Border Padding="6,3"
                                                                CornerRadius="8"
                                                                Background="{ThemeResource NoirLumenAccentSoftBrush}"
                                                                BorderBrush="{ThemeResource NoirLumenAccentBrush}"
                                                                BorderThickness="1">
                                                            <TextBlock Text="Overlay" />
                                                        </Border>
                                                        <Border Padding="6,3"
                                                                CornerRadius="8"
                                                                Background="{ThemeResource NoirLumenSurfaceBrush}"
                                                                BorderBrush="{ThemeResource NoirLumenStrokeBrush}"
                                                                BorderThickness="1">
                                                            <TextBlock Text="Sun" />
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Spacing="8">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <ToggleSwitch Header="On" IsOn="{Binding IsEnabled, Mode=TwoWay}" />
                                                        <ToggleSwitch Header="Sun" IsOn="{Binding SunMimicEnabled, Mode=TwoWay}" />
                                                    </StackPanel>
                                                    <StackPanel Spacing="3">
                                                        <TextBlock Text="Dim level" />
                                                        <Slider Minimum="0" Maximum="95" Value="{Binding DimPercent, Mode=TwoWay}" />
                                                    </StackPanel>
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <TextBlock Text="Blue light" VerticalAlignment="Center" />
                                                            <ComboBox Width="118" SelectedIndex="{Binding BlueLightMode, Mode=TwoWay}">
                                                                <ComboBoxItem Content="Off" />
                                                                <ComboBoxItem Content="Gentle" />
                                                                <ComboBoxItem Content="Warm" />
                                                                <ComboBoxItem Content="Amber" />
                                                                <ComboBoxItem Content="Red" />
                                                            </ComboBox>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                            <TextBox Width="100" Text="{Binding ColorHex, Mode=TwoWay}" />
                                                            <Button Content="Pick" Tag="{Binding}" Click="PickMonitorColor_OnClick" Style="{StaticResource NoirSurfaceButtonStyle}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Padding="12"
                            CornerRadius="12"
                            Background="{ThemeResource NoirLumenSurfaceBrush}"
                            BorderBrush="{ThemeResource NoirLumenStrokeBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Sun mimic" Style="{StaticResource NoirSectionTitleStyle}" />
                            <TextBlock Text="Uses latitude/longitude and a softer sunset curve." Style="{StaticResource NoirSectionBodyStyle}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Lat" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding Latitude, Mode=TwoWay}" />
                                <TextBlock Grid.Row="1" Text="Lon" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Longitude, Mode=TwoWay}" />
                                <TextBlock Grid.Row="2" Text="Max" VerticalAlignment="Center" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SunMimicMaximumDimPercent, Mode=TwoWay}" />
                            </Grid>
                            <Button Content="Auto detect location" Click="AutoDetectLocation_OnClick" Style="{StaticResource NoirSurfaceButtonStyle}" />
                            <TextBlock Text="{Binding SunMimicStatusText}" Style="{StaticResource NoirSectionBodyStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1"
                            Padding="12"
                            CornerRadius="12"
                            Background="{ThemeResource NoirLumenSurfaceBrush}"
                            BorderBrush="{ThemeResource NoirLumenStrokeBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Automation summary" Style="{StaticResource NoirSectionTitleStyle}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Padding="8"
                                        CornerRadius="8"
                                        Background="{ThemeResource NoirLumenSurfaceAltBrush}"
                                        BorderBrush="{ThemeResource NoirLumenStrokeBrush}"
                                        BorderThickness="1">
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="{Binding EnabledDisplayCount}" Style="{StaticResource NoirMetricValueStyle}" />
                                        <TextBlock Text="Active" Style="{StaticResource NoirMetricLabelStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1"
                                        Padding="8"
                                        CornerRadius="8"
                                        Background="{ThemeResource NoirLumenSurfaceAltBrush}"
                                        BorderBrush="{ThemeResource NoirLumenStrokeBrush}"
                                        BorderThickness="1">
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="{Binding EnabledRuleCount}" Style="{StaticResource NoirMetricValueStyle}" />
                                        <TextBlock Text="Rules" Style="{StaticResource NoirMetricLabelStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2"
                                        Padding="8"
                                        CornerRadius="8"
                                        Background="{ThemeResource NoirLumenSurfaceAltBrush}"
                                        BorderBrush="{ThemeResource NoirLumenStrokeBrush}"
                                        BorderThickness="1">
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="{Binding ProcessRuleCount}" Style="{StaticResource NoirMetricValueStyle}" />
                                        <TextBlock Text="Process" Style="{StaticResource NoirMetricLabelStyle}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2"
                            Padding="12"
                            CornerRadius="12"
                            Background="{ThemeResource NoirLumenSurfaceBrush}"
                            BorderBrush="{ThemeResource NoirLumenStrokeBrush}"
                            BorderThickness="1">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock Text="Automation rules" Style="{StaticResource NoirSectionTitleStyle}" />
                                <TextBlock Text="Keep the list compact. Open a rule to edit the details." Style="{StaticResource NoirSectionBodyStyle}" />
                            </StackPanel>

                            <ListView Grid.Row="1"
                                      ItemsSource="{Binding Rules}"
                                      SelectedItem="{Binding SelectedRule, Mode=TwoWay}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8"
                                                Padding="10"
                                                CornerRadius="10"
                                                Background="{ThemeResource NoirLumenSurfaceAltBrush}"
                                                BorderBrush="{ThemeResource NoirLumenStrokeBrush}"
                                                BorderThickness="1">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Type}" Style="{StaticResource NoirSectionBodyStyle}" />
                                                    <TextBlock Text="{Binding RuntimeStateLabel}" Style="{StaticResource NoirSectionBodyStyle}" />
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Content="On" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <StackPanel Grid.Row="2" Spacing="8">
                                <TextBlock Text="{Binding SelectedRuleSummaryText}"
                                           Style="{StaticResource NoirSectionBodyStyle}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                    <Button Content="Add nightly dim" Click="AddTimeRule_OnClick" />
                                    <Button Content="Add app rule" Click="AddProcessRule_OnClick" />
                                    <Button Content="Edit selected" Click="EditRule_OnClick" />
                                    <Button Content="Duplicate selected" Click="DuplicateRule_OnClick" />
                                    <Button Content="Remove selected" Click="RemoveRule_OnClick" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2"
                Padding="10"
                CornerRadius="12"
                Background="{ThemeResource NoirLumenSurfaceBrush}"
                BorderBrush="{ThemeResource NoirLumenStrokeBrush}"
                BorderThickness="1">
            <Grid ColumnSpacing="10" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Process rules use the exe name. Time format: HH:mm."
                           VerticalAlignment="Center"
                           Style="{StaticResource NoirSectionBodyStyle}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Import" Click="ImportSettings_OnClick" Style="{StaticResource NoirSurfaceButtonStyle}" />
                    <Button Content="Export" Click="ExportSettings_OnClick" Style="{StaticResource NoirSurfaceButtonStyle}" />
                    <Button Content="Apply Now" Click="ApplyNow_OnClick" Style="{StaticResource NoirLumenPrimaryButtonStyle}" />
                    <Button Content="Save" Click="Save_OnClick" Style="{StaticResource NoirSurfaceButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
